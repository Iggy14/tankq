# Copy to .env.local for development, or set on the server for production.
# Every variable is optional: with none set the site builds and runs from the
# built-in data in src/lib.

# Public origin of the site (canonical URLs, Open Graph, sitemap).
NEXT_PUBLIC_SITE_URL=https://www.tankq-solution.com

# WordPress origin, no trailing slash. When set, products, categories,
# projects and services are read from its REST API instead of src/lib.
# Local development: the LocalWP site URL, e.g. http://tankq-cms.local
WP_API_URL=

# Shared secret for POST /api/revalidate. The same value goes in the
# WordPress plugin's wp-config.php constant TANKQ_REVALIDATE_SECRET.
REVALIDATE_SECRET=

# Used only by scripts/migrate-to-wp.ts, never by the site itself.
# An Application Password (Users > Profile in WordPress admin).
WP_USER=
WP_APP_PASSWORD=
